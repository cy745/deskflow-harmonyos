/*
 * 说明：真实签名信息（证书 .cer / profile .p7b / 密钥库 .p12 及密码）存放在用户主目录
 * `~/.ohos/config/` 下，**不会**提交到 Git 仓库，也不应出现在本文件中。
 * 每位开发者用 DevEco Studio 打开工程后，在 File → Project Structure → Signing Configs
 * 里勾选 "Automatically generate signature" 自行生成并绑定到本机，
 * DevEco 会在本地把 signingConfigs 写回本文件（仅本机可见，若你看到签名段出现，
 * 请在提交前删除，或把本文件加入 .git/info/exclude 并维护本地副本）。
 */
{
  "app": {
    "products": [
      {
        "name": "default",
        "compileSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
