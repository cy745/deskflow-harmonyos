# 行尾统一为 LF（防止 Windows 上 CRLF 混乱）
* text=auto

# 文本文件统一 LF
*.ts text eol=lf
*.ets text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.bat text eol=crlf

# 二进制文件不转行尾
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.so binary
*.hap binary
*.p12 binary
*.p7b binary
*.cer binary
